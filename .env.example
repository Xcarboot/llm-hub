# 原样复制后会因占位秘密拒绝启动。仅在本地/部署环境填写，切勿提交 .env。
# ADMIN_TOKEN 与 API_KEY_HMAC_SECRET 须分别生成不同的随机值（至少 32 字符）：
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
APP_ENV=development
# 下列数据库与 Redis 主机名用于 Docker Compose；宿主机开发须改为实际可访问地址。
DATABASE_URL=postgresql+asyncpg://gateway:REPLACE_ME@postgres:5432/gateway
REDIS_URL=redis://redis:6379/0
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN
API_KEY_HMAC_SECRET=REPLACE_WITH_A_LONG_RANDOM_HMAC_SECRET
LITELLM_CONFIG_PATH=litellm_config.yaml
# 生产须填写实际服务主机名并隔离管理员接口，不要用通配符代替访问控制。
TRUSTED_HOSTS=localhost,127.0.0.1
# 门户通过 /api 同源代理访问；CORS 设置不能代替 CUSTOMER_ALLOWED_ORIGINS 或 CSRF 校验。
CORS_ORIGINS=

# 客户门户无默认密码，由管理员生成一次性激活链接，客户自设至少 12 位密码。
# Cookie 默认为 HttpOnly + SameSite=Lax + Secure；生产必须使用 TLS 并保持 true。
# 仅 development/test 的本机明文 HTTP 测试可临时设为 false，其他环境会拒绝启动。
CUSTOMER_COOKIE_SECURE=true
# 逗号分隔的完整浏览器 Origin，含协议/端口，不含路径/末尾斜线；必须精确匹配。
# 首项用于生成激活链接；localhost 与 127.0.0.1 不同，生产须替换为真实 HTTPS 来源。
CUSTOMER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 会话有效期 1 小时、一次性激活链接有效期 24 小时（秒，必须大于 0）。
CUSTOMER_SESSION_TTL_SECONDS=3600
ACTIVATION_TTL_SECONDS=86400

# disabled 为安全默认值；mock 仅在 APP_ENV=development/test 时允许，否则拒绝启动。
# mock 只做本机模拟，不收退真实资金，不跳转支付宝；务必使用隔离测试数据库。
# 单次充值/退款申请须为正数整分，0.01–1000 元；创建订单不等于到账，退款须管理员审批。
# alipay_sandbox 尚未接通：创建支付订单/退款执行返回 503，不会伪造成功。
PAYMENT_MODE=disabled

MAX_REQUEST_BYTES=1048576
MAX_MESSAGE_CHARS=100000
MAX_OUTPUT_TOKENS=8192
TOKEN_ESTIMATE_SAFETY_FACTOR=1.25
RPM_LIMIT=60
TPM_LIMIT=200000
CONCURRENCY_LIMIT=10
CONCURRENCY_LEASE_SECONDS=300
# 必须严格小于 CONCURRENCY_LEASE_SECONDS。
REQUEST_TIMEOUT_SECONDS=120
RESERVATION_TTL_SECONDS=600

# 实际网关仍从 litellm_config.yaml 解析主/备别名与环境变量，YAML 不得写入真实密钥。
# 供应商地址及密钥仅为占位，需在本地替换；页面供应商密钥配置尚未实现。
PRIMARY_PROVIDER_API_BASE=https://REPLACE_WITH_APPROVED_PRIMARY_ENDPOINT/v1
PRIMARY_PROVIDER_API_KEY=REPLACE_ME
FALLBACK_PROVIDER_API_BASE=https://REPLACE_WITH_APPROVED_FALLBACK_ENDPOINT/v1
FALLBACK_PROVIDER_API_KEY=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME

# ProviderConfig 仅表结构/输入模型预留，无配置页面、管理路由或运行时接入。
# 以下设置当前未用于密钥加密或出站域名校验，留空/默认值不会启用供应商配置功能。
PROVIDER_ENCRYPTION_KEY=
PROVIDER_ALLOWED_HOST_SUFFIXES=cn-beijing.maas.aliyuncs.com,dashscope.aliyuncs.com

# 支付宝设置仅为未来接入预留，全部留空；填写也不会接通沙箱或真实支付。
# 尚无支付请求、回调验签、查单或真实退款调用，请勿在示例文件中加入任何真实凭据。
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PUBLIC_KEY=
ALIPAY_PRIVATE_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
